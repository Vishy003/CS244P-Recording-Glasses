{
  "uid": "group18-vertical-slice",
  "title": "Group 18 Vertical Slice - Real IMU",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-5m",
    "to": "now"
  },
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "What this test demonstrates",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "**Real IMU \u2192 XIAO ESP32S3 \u2192 Wi-Fi \u2192 authenticated MQTT over TLS \u2192 Telegraf \u2192 InfluxDB \u2192 Grafana.** Only messages tagged `source=xiao_imu` appear here. Tilt the sensor gently to change acceleration axes. Acceleration includes gravity (~9.81 m/s\u00b2 at rest). No camera or microphone is initialized by this test. Empty panels mean no matching readings in the selected time range."
      }
    },
    {
      "id": 2,
      "title": "Latest X acceleration (m/s\u00b2)",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 8,
        "h": 5
      },
      "datasource": {
        "type": "influxdb",
        "uid": "group18-influx"
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"telemetry\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn: (r) => r._measurement == \"glasses\" and r.source == \"xiao_imu\") |> filter(fn: (r) => r._field == \"acceleration_m_s2_0\") |> last()"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 3
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "graphMode": "area",
        "colorMode": "value"
      }
    },
    {
