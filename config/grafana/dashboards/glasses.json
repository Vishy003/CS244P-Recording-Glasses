{
  "uid": "group18-glasses",
  "title": "Group 18 Recording Glasses",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "10s",
  "timezone": "browser",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "tags": [
    "Group18",
    "IoT"
  ],
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Connection status and scope",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "**Server and device integration test.** A course-kit ESP32 test reports only real uptime, free heap, and Wi-Fi RSSI with `source=kit_esp32_test`. It is not a camera-glasses recording test. Battery and motion panels stay empty until actual sensors report data. Synthetic smoke-test records are explicitly labelled and deleted. Snapshot upload, recording commands, and alert delivery remain pending."
      }
    },
    {
      "id": 2,
      "title": "Battery voltage",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 8,
        "h": 5
      },
      "datasource": {
        "type": "influxdb",
        "uid": "group18-influx"
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"telemetry\") |> range(start: v.timeRangeStart, stop: v.timeRangeStop) |> filter(fn: (r) => r._measurement == \"glasses\") |> filter(fn: (r) => r._field == \"battery_v\") |> last()"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "volt"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "id": 3,
